#!/usr/bin/env bash
set -Eeuo pipefail

readonly MEDIASTACK_HOME="${MEDIASTACK_HOME:-/opt/mediastack}"

if [[ -f "${MEDIASTACK_HOME}/VERSION" ]]; then
    MEDIASTACK_VERSION="$(tr -d '[:space:]' < "${MEDIASTACK_HOME}/VERSION")"
else
    MEDIASTACK_VERSION="2.1.0"
fi
readonly MEDIASTACK_VERSION

: "${MEDIASTACK_CHANNEL:=stable}"
readonly MEDIASTACK_CHANNEL

source "${MEDIASTACK_HOME}/lib/core/constants.sh"
source "${MEDIASTACK_HOME}/lib/core/output.sh"
source "${MEDIASTACK_HOME}/lib/core/common.sh"
source "${MEDIASTACK_HOME}/lib/core/router.sh"

media_main "$@"
